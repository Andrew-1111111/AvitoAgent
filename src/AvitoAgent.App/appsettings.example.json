{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "System": "Warning"
      }
    }
  },

  "LmStudio": {
    "Enabled": false,
    "BaseUrl": "http://localhost:1234/v1/",
    "Model": "qwen/qwen3.5-9b",
    "AutoSelectModel": true,
    "AutoLoadModel": true,
    "LoadContextLength": 32768,
    "UseJsonSchemaResponse": false,
    "MaxImages": 1,
    "ContextUsagePercent": 70,
    "MaxCompletionTokens": 800,
    "OptimizeImages": false,
    "MaxImageSidePx": 1024,
    "ImageJpegQuality": 85,
    "UseExternalSystemPrompt": false,
    "Temperature": 0.1,
    "RequestTimeoutSeconds": 900
  },

  "Telegram": {
    "Enabled": false,
    "ControlEnabled": true,
    "ChatGptPhotoCheckEnabled": false,
    "ChatGptPhotoCheckPrompt": "Проверь подлинность товара по фотографиям, открывай ссылки через браузер, выдай краткий ответ.",
    "MaxPhotos": 5,
    "BotToken": "",
    "ChatId": "",
    "NetworkInterface": "",
    "Socks5": {
      "Enabled": false,
      "Host": "127.0.0.1",
      "Port": 1080,
      "Username": "",
      "Password": ""
    }
  },

  "Worker": {
    "PollingIntervalMinutes": 10,
    "SleepFromHour": 22,
    "SleepToHour": 10,
    "TimezoneId": "Europe/Moscow",
    "Keywords": [ "Бензогенератор elemax" ],
    "ExcludedKeywords": [ "не оригинал" ],
    "MinPrice": 0,
    "MaxPrice": 0,
    "MaxResults": 50,
    "MinAuthenticityScore": 60
  },

  "Avito": {
    "Filters": {
      "LocationSlug": [ "Московская область" ],
      "Sort": "По дате",
      "SortValues": [ "По умолчанию", "Дешевле", "Дороже", "По дате", "По размеру скидки" ],
      "DeliveryOnly": true,
      "Condition": "Все",
      "ConditionValues": [ "Все", "Новое", "Б/у" ],
      "SellerType": "Все",
      "SellerTypeValues": [ "Все", "Частные", "Компании" ],
      "FromCurrentDateTime": false
    },
    "BaseUrl": "https://www.avito.ru",
    "MaxPages": 3,
    "NavigationTimeoutMs": 60000,
    "SearchWarmupMs": 2500,
    "SearchWarmupJitterMs": 1500,
    "NavigateViaHomepage": true,
    "DetailDelayMs": 2500,
    "DetailDelayJitterMs": 2000,
    "DetailPageSettleMs": 900,
    "DetailPageSettleJitterMs": 700,
    "DetailDelayAfterMs": 1600,
    "DetailDelayAfterJitterMs": 1400,
    "SearchPageDelayMs": 2500,
    "SearchPageDelayJitterMs": 1500,
    "SearchResultsWaitMs": 25000,
    "MaxCardsPerSearchPage": 50,
    "MaxDetailsPerSearch": 0,
    "ClickListingLinks": true,
    "StopOnBlock": true,
    "ManualCaptchaWaitMs": 0,
    "ManualCaptchaPollMs": 2000,
    "PostCaptchaDelayMs": 120000,
    "DetailGalleryInitialDelayMs": 1200,
    "DetailGalleryInitialDelayJitterMs": 900,
    "GalleryPhotoDelayMs": 1600,
    "GalleryPhotoDelayJitterMs": 1100,
    "MaxGalleryPhotos": 0,
    "Auth": {
      "Enabled": false,
      "Phone": "",
      "Email": "",
      "Password": "",
      "StorageStateFile": "avito-auth.json",
      "LoginTimeoutMs": 180000,
      "FormSearchTimeoutMs": 30000
    }
  },

  "Playwright": {
    "UsePersistentProfile": true,
    "UserDataDir": "",
    "BlockTrackers": true,
    "Launch": {
      "Browser": "Chromium",
      "Channel": "chrome",
      "Headless": false,
      "Timeout": 30000,
      "SlowMo": 0,
      "IgnoreAllDefaultArguments": false,
      "Arguments": [
        "--disable-blink-features=AutomationControlled"
      ]
    },
    "Context": {
      "Locale": "ru-RU",
      "TimezoneId": "Europe/Moscow",
      "UserAgent": "",
      "EmulateViewport": false,
      "Viewport": {
        "Width": 1920,
        "Height": 1080
      },
      "DeviceScaleFactor": 1.0,
      "StorageStatePath": "data/avito-auth.json"
    },
    "Proxy": {
      "Enabled": false
    }
  },

  "Socks5": {
    "Enabled": false,
    "Host": "127.0.0.1",
    "Port": 1080,
    "Username": "",
    "Password": ""
  },

  "Network": {
    "Interface": ""
  },

  "Debug": {
    "BrowserLog": false,
    "ExportListingPhotos": false,
    "ListingPhotosDirectory": "debug/listing-photos"
  }
}
